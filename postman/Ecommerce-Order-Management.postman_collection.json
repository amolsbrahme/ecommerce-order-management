  "item": [
    {
      "name": "1. Infrastructure Health",
      "description": "Sanity checks that the stack is up before exercising the business APIs. Run these first if anything below returns connection errors.",
      "item": [
        {
          "name": "Discovery Server (Eureka) Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{eurekaUrl}}",
              "host": [
                "{{eurekaUrl}}"
              ],
              "path": []
            },
            "description": "HTML dashboard - open in a browser rather than Postman's preview for a readable view. Confirms which services are currently registered and UP. Protected with HTTP Basic auth (admin/admin by default).",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{eurekaUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{eurekaPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "API Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/actuator/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Confirms the gateway itself is up and can reach Eureka."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Auth (Keycloak)",
      "description": "Run 'Get Admin Token' and 'Get Customer Token' once at the start of a session - each captures its access_token into the {{adminToken}} / {{customerToken}} collection variables, which every other request in this collection references via Bearer auth. Tokens are short-lived (Keycloak default: 5 minutes); re-run the relevant request here if you start getting 401s partway through a session.\n\nUses the public 'ecommerce-client' with the OAuth2 Resource Owner Password Credentials grant, which is fine for local/demo testing against the seeded demo-admin / demo-customer users but is not a pattern to carry into a production client.",
      "item": [
        {
          "name": "Get Admin Token (demo-admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "demo-admin holds both ADMIN and CUSTOMER realm roles, so this token works for every endpoint in the collection.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{adminUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "    pm.collectionVariables.set('adminToken', body.access_token);",
                  "    console.log('adminToken captured, expires in ' + body.expires_in + 's');",
                  "} else {",
                  "    console.warn('No access_token in response - check the username/password/client_id collection variables.');",
                  "}",
                  "pm.test('Token request succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Customer Token (demo-customer)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "demo-customer holds only the CUSTOMER realm role - use this token to confirm customer-permitted endpoints (orders, notifications) work and admin-only endpoints (product/inventory writes) correctly return 403.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{customerUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{customerPassword}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "    pm.collectionVariables.set('customerToken', body.access_token);",
                  "    console.log('customerToken captured, expires in ' + body.expires_in + 's');",
                  "} else {",
                  "    console.warn('No access_token in response - check the username/password/client_id collection variables.');",
                  "}",
                  "pm.test('Token request succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Product Service",
      "description": "Product catalog CRUD, routed through the API Gateway at /api/products/**. GET is public (no token required); POST/PUT/DELETE require the ADMIN realm role.",
      "item": [
        {
          "name": "Create Product [ADMIN]",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/products",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Creates a catalog entry. Captures the returned 'id' into {{productId}} for the two requests below. Returns 409 if the SKU already exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sku\": \"{{sku}}\",\n    \"name\": \"Wireless Mouse\",\n    \"description\": \"2.4GHz wireless mouse\",\n    \"category\": \"Electronics\",\n    \"price\": 19.99,\n    \"initialStockHint\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('productId', body.id);",
                  "    console.log('productId captured: ' + body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
