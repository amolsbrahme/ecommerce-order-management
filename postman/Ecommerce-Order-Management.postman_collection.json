    {
      "name": "4. Inventory Service",
      "description": "Stock tracking, routed through the API Gateway at /api/inventory/** - all admin-only. Note: the reserve/release calls here hit the same endpoints Order Service calls internally via its RestClient-backed HTTP interface client when you place an order (Folder 5) - those internal calls bypass the gateway entirely and carry no JWT (see SecurityConfig's comment on this). Use these requests to seed stock and to poke the reservation logic directly.",
      "item": [
        {
          "name": "Create Stock Record [ADMIN]",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory"
              ]
            },
            "description": "Seeds stock for {{sku}}. Returns 409 if a stock record for this SKU already exists - use 'Set Available Quantity' instead to top it up.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sku\": \"{{sku}}\",\n    \"availableQuantity\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Stock by SKU [ADMIN]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory/{{sku}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "{{sku}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reserve Stock [ADMIN]",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory/{{sku}}/reserve",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "{{sku}}",
                "reserve"
              ]
            },
            "description": "Moves quantity from available to reserved. Returns 409 Conflict if availableQuantity is less than the requested quantity - this is the exact response Order Service's InventoryGateway interprets as an insufficient-stock business rejection (not a circuit-breaker trip).",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Release Stock [ADMIN]",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory/{{sku}}/release",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "{{sku}}",
                "release"
              ]
            },
            "description": "The compensating action for Reserve - moves quantity back from reserved to available. Order Service calls this automatically when a multi-item order fails partway through.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Set Available Quantity (replenish) [ADMIN]",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory/{{sku}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "{{sku}}"
              ]
            },
            "description": "Overwrites availableQuantity directly - use this to top up stock between test runs instead of deleting/recreating the stock record.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"quantity\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reserve Stock - Insufficient Stock (409) [ADMIN]",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory/{{sku}}/reserve",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "{{sku}}",
                "reserve"
              ]
            },
            "description": "Requests far more than is available - expect 409 Conflict. Run 'Place Order' with a large quantity afterwards to see this same rejection surface as an order with status FAILED (Section 6.2/12.2 of the project report).",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"quantity\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
