    {
      "name": "5. Order Service",
      "description": "Order placement and retrieval, routed through /api/orders/** - requires a CUSTOMER or ADMIN token. Run '4. Inventory Service > Create Stock Record' first so {{sku}} has stock to reserve.",
      "item": [
        {
          "name": "Place Order (happy path) [CUSTOMER]",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/orders",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Reserves stock synchronously via a RestClient-backed HTTP interface client + the Resilience4J circuit breaker, persists the order, and - only if every item reserved successfully - publishes an OrderPlacedEvent to Kafka. Captures {{orderNumber}} for the request below. Still returns 201 even when the order ends up FAILED (see the next request) - the HTTP status reflects that an order record was created, the status field carries the actual outcome.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": \"{{customerId}}\",\n    \"items\": [\n        {\n            \"sku\": \"{{sku}}\",\n            \"quantity\": 2,\n            \"unitPrice\": 19.99\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('orderNumber', body.orderNumber);",
                  "    console.log('orderNumber captured: ' + body.orderNumber + ' (status: ' + body.status + ')');",
                  "    pm.test('Order was created (status field carries the business outcome)', function () {",
                  "        pm.expect(['CONFIRMED', 'FAILED']).to.include(body.status);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Place Order - Insufficient Stock (still 201, status FAILED) [CUSTOMER]",
          "request": {
